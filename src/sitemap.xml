---
permalink: /sitemap.xml
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% (site.resources + site.generated_pages).each do |item| %>
<% next if item.data.sitemap == false %>
<% next if item.data.permalink == "/404.html" %>
<% loc = item.respond_to?(:absolute_url) ? item.absolute_url : absolute_url(item.url) %>
<% next if loc.to_s.strip.empty? %>
<% last_modified = begin
     File.mtime(item.path).strftime("%Y-%m-%d")
   rescue StandardError
     site.time.strftime("%Y-%m-%d")
   end %>
  <url>
    <loc><%= loc %></loc>
    <lastmod><%= last_modified %></lastmod>
  </url>
<% end %>
</urlset>
