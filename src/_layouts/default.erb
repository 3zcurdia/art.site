<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
      // Reveal animations only run with JavaScript. If main.js fails to
      // initialize, the load fallback restores the content instead of leaving
      // every .reveal block invisible.
      document.documentElement.classList.add("js");
      window.addEventListener("load", function () {
        if (!window.siteInitialized) {
          document.documentElement.classList.remove("js");
        }
      });
    </script>
    <%= render "seo" %>
    <%= render "schema" %>

    <!-- Self-hosted fonts (src/assets/fonts). Preload the above-the-fold faces. -->
    <link
      rel="preload"
      href="<%= relative_url '/assets/fonts/playfair-display-latin-400-700.woff2' %>"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="<%= relative_url '/assets/fonts/quicksand-latin-300-600.woff2' %>"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Compiled Tailwind CSS (see frontend/styles/index.css) -->
    <link rel="stylesheet" href="<%= asset_path :css %>" />
  </head>
  <body class="bg-warm-ivory text-gray-800">
    <%= render "navbar" %>

    <main><%= yield %></main>

    <%= render "footer" %>

    <!-- Lightbox -->
    <div
      id="lightbox"
      class="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Vista ampliada de la obra"
      aria-hidden="true"
    >
      <button type="button" class="lightbox-close" aria-label="Cerrar vista ampliada">
        &times;
      </button>
      <img id="lightbox-img" alt="" />
    </div>

    <script src="<%= relative_url '/assets/js/main.js' %>"></script>
  </body>
</html>
