<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= data.title || site.metadata.title %></title>
    <meta name="description" content="<%= data.description || site.metadata.description %>" />

    <!-- Compiled Tailwind CSS (see frontend/styles/index.css) -->
    <link rel="stylesheet" href="<%= asset_path :css %>" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Quicksand:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-warm-ivory text-gray-800">
    <%= render "navbar" %>

    <main><%= yield %></main>

    <%= render "footer" %>

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox">
      <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
      <img id="lightbox-img" src="" alt="Artwork" />
    </div>

    <script src="<%= relative_url '/assets/js/main.js' %>"></script>
  </body>
</html>
