<nav
  id="navbar"
  aria-label="Principal"
  class="fixed w-full top-0 z-50 transition-all duration-300 bg-warm-ivory/95 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="<%= relative_url '/' %>#hero" class="flex items-center space-x-3">
        <img
          src="<%= relative_url '/assets/images/logo.webp' %>"
          alt="IE Logo"
          width="320"
          height="320"
          class="h-12 w-12 object-contain"
        />
        <span class="font-serif text-xl text-dusty-sage hidden sm:block"
          >Irasema Ezcurdia</span
        >
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        <a
          href="<%= relative_url '/' %>#hero"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Inicio</a
        >
        <a
          href="<%= relative_url '/' %>#portfolio"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Portafolio</a
        >
        <a
          href="<%= relative_url '/' %>#video"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Video</a
        >
        <a
          href="<%= relative_url '/' %>#about"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Sobre Mí</a
        >
        <a
          href="<%= relative_url '/' %>#trayectoria"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Trayectoria</a
        >
        <a
          href="<%= relative_url '/' %>#testimonials"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Testimonios</a
        >
        <a
          href="<%= relative_url '/' %>#contact"
          class="nav-link text-gray-700 hover:text-dusty-sage transition-colors font-medium"
          >Contacto</a
        >
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-dusty-sage p-2"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <span class="sr-only">Menú de navegación</span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <a href="<%= relative_url '/' %>#hero" class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Inicio</a
      >
      <a
        href="<%= relative_url '/' %>#portfolio"
        class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Portafolio</a
      >
      <a href="<%= relative_url '/' %>#video" class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Video</a
      >
      <a href="<%= relative_url '/' %>#about" class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Sobre Mí</a
      >
      <a
        href="<%= relative_url '/' %>#trayectoria"
        class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Trayectoria</a
      >
      <a
        href="<%= relative_url '/' %>#testimonials"
        class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Testimonios</a
      >
      <a href="<%= relative_url '/' %>#contact" class="block py-2 text-gray-700 hover:text-dusty-sage"
        >Contacto</a
      >
    </div>
  </div>
</nav>
