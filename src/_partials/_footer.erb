<footer
  class="bg-gradient-to-b from-soft-cream to-warm-ivory py-12 border-t border-muted-rose/30"
>
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center">
      <!-- Logo -->
      <img
        src="<%= relative_url '/assets/images/logo.webp' %>"
        alt=""
        width="320"
        height="320"
        class="h-16 w-16 object-contain mx-auto mb-4"
      />
      <p class="font-serif text-2xl text-dusty-sage mb-2">Irasema Ezcurdia</p>
      <p class="text-soft-gray mb-6">Art Toys • Miniaturas • Cerámica</p>

      <!-- Site links -->
      <nav aria-label="Enlaces del sitio" class="mb-6">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
          <li>
            <a
              href="<%= relative_url '/full-portfolio/' %>"
              class="text-dusty-sage hover:text-muted-rose transition-colors"
              >Portafolio completo</a
            >
          </li>
          <li>
            <a
              href="<%= relative_url '/sobre-mi/' %>"
              class="text-dusty-sage hover:text-muted-rose transition-colors"
              >Sobre mí</a
            >
          </li>
          <li>
            <a
              href="<%= relative_url '/prensa/' %>"
              class="text-dusty-sage hover:text-muted-rose transition-colors"
              >Prensa y exposiciones</a
            >
          </li>
          <li>
            <a
              href="<%= relative_url '/contacto/' %>"
              class="text-dusty-sage hover:text-muted-rose transition-colors"
              >Contacto</a
            >
          </li>
        </ul>
      </nav>

      <!-- Contact -->
      <p class="text-sm text-soft-gray mb-8">
        <a
          href="mailto:<%= site.metadata.email %>"
          class="hover:text-muted-rose transition-colors"
          ><%= site.metadata.email %></a
        >
        <span class="mx-2" aria-hidden="true">·</span>
        <span><%= site.metadata.location %></span>
      </p>

      <!-- Social Links -->
      <div class="flex justify-center space-x-6 mb-8">
        <a
          href="<%= site.metadata.instagram %>"
          target="_blank"
          rel="me noopener"
          class="text-dusty-sage hover:text-muted-rose transition-colors"
          aria-label="Instagram de Irasema Ezcurdia @irasema_ezcurdia"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            />
          </svg>
        </a>
      </div>

      <!-- Decorative line -->
      <div class="flex items-center justify-center mb-6">
        <div class="h-px w-16 bg-muted-rose/40"></div>
        <span class="mx-4 text-muted-rose">✧</span>
        <div class="h-px w-16 bg-muted-rose/40"></div>
      </div>

      <p class="text-gray-500 text-sm">
        &copy; <%= Time.now.year %> Irasema Ezcurdia. Todos los derechos
        reservados.
      </p>
    </div>
  </div>
</footer>
